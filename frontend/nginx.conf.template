# Served by nginxinc/nginx-unprivileged (see Dockerfile). ${API_UPSTREAM} is filled in at container start.
#
# PRIVACY: the app puts the chosen latitude/longitude in the page URL (?lat=..&lon=..) and in /api/analyze query strings.
# This log format records only the path ($uri, no query string) and NEVER the Referer, so coordinates never reach the logs.
# Do not add $request, $request_uri, $args or $http_referer to it.
log_format bwf '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';

# Behind a CDN / load balancer, uncomment and set the proxy's address range so $remote_addr (used for rate limiting)
# is the real client rather than the proxy:
#   set_real_ip_from 10.0.0.0/8;
#   real_ip_header   X-Forwarded-For;
#   real_ip_recursive on;

server {
  listen 8080;
  server_name _;
  server_tokens off;
  root /usr/share/nginx/html;
  index index.html;
  access_log /dev/stdout bwf;
  error_log  /dev/stderr warn;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Security headers. img-src allows https: because map tiles come from the tile provider you configure
  # (see .env.example); tighten it to that host once you have chosen one.
  # If you set VITE_API_BASE to another origin, add it to connect-src.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  # Cross-origin requests (map tiles) get the origin only, never the page URL with its coordinates.
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;

  # API: the backend container is NOT published; only this proxy reaches it. The backend's rate limiter keys on X-Real-IP.
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
    client_max_body_size 64k;
    add_header Cache-Control "no-store" always;
    # add_header in a location replaces the server-level ones, so repeat the ones that matter here
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  }

  # Hashed build files never change: cache for a year.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # Single-page app: unknown paths serve index.html (the router then decides). Never cache it.
  location / {
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
    try_files $uri /index.html;
  }
}
