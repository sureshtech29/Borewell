# Where the API lives. "/api" works when nginx (or the Vite dev proxy) forwards /api to the backend.
VITE_API_BASE=/api

# Map tiles. These defaults are for development and light use ONLY:
#  - OpenStreetMap's public tile servers have a usage policy (no heavy/commercial traffic, attribution required).
#  - Esri World Imagery has its own terms of use (attribution required; check licensing before public launch).
# For production use a provider you have a plan/agreement with (MapTiler, Mapbox, Stadia, your own tile server, ...).
VITE_TILE_STREET_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_STREET_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_TILE_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_TILE_SATELLITE_ATTRIBUTION=Imagery &copy; Esri, Maxar, Earthstar Geographics and the GIS User Community
