# Copy to .env (never commit .env).

# --- database -----------------------------------------------------------------------------------------------
# Used inside DATABASE_URL, so use letters and digits only (or URL-encode special characters).
POSTGRES_PASSWORD=change-me-please

# --- data mode ----------------------------------------------------------------------------------------------
# demo        = synthetic sample data, clearly labelled everywhere. For trying the app out. Never for decisions.
# production  = only real data; refuses to start on demo data (see README "Switching to real data").
APP_DATA_MODE=demo
# Load the synthetic demo data into an EMPTY database volume the first time it starts. Use false for production.
SEED_DEMO=true

# --- public site --------------------------------------------------------------------------------------------
WEB_PORT=8080
# Shown on the Contact page. Leave empty to hide it (messages are still stored by the contact form).
CONTACT_EMAIL=
# Show individual historical borewell points on the map. Empty = demo: yes, production: no.
# Real borewell records are often tied to named owners; only turn this on if your data licence allows it.
SHOW_RECORD_POINTS=
RATE_LIMIT_PER_MIN=60

# --- optional AI report explanation (server-side only) ----------------------------------------------------
# AI explains existing report evidence; it does NOT improve or validate groundwater predictions.
# Leave AI_API_KEY empty to disable the feature. Never put this key in frontend VITE_ variables.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# --- map tiles (baked into the web build) -------------------------------------------------------------------
# Leave empty for the development defaults (OpenStreetMap + Esri World Imagery). Those public servers have
# usage policies and are not meant for a busy public site: use a provider you have an agreement with.
VITE_TILE_STREET_URL=
VITE_TILE_STREET_ATTRIBUTION=
VITE_TILE_SATELLITE_URL=
VITE_TILE_SATELLITE_ATTRIBUTION=
